# Postgres connection used by the API, worker, and scheduler binaries.
DATABASE_URL=postgres://jobqueue:jobqueue@localhost:5432/jobqueue?sslmode=disable

# HTTP address the API binds to.
API_ADDR=:8080

# Worker pool.
WORKER_CONCURRENCY=4
WORKER_CLAIM_BATCH_SIZE=4
WORKER_POLL_INTERVAL=500ms
# Kept small on purpose: this is a direct latency floor on how long a job
# enqueued during an idle period can wait before any worker asks again.
# LISTEN/NOTIFY would remove the floor entirely - see README limitations.
WORKER_MAX_POLL_INTERVAL=2s
WORKER_JOB_TIMEOUT=30s
# Must be shorter than your deployment platform's SIGTERM->SIGKILL grace
# period (Fly's kill_timeout, ECS's stopTimeout), with margin for the
# release write itself - see README.
WORKER_DRAIN_TIMEOUT=25s

# Worker heartbeat.
WORKER_HEARTBEAT_INTERVAL=10s
# How long a worker can go without heartbeating before its row is removed
# (crashed or SIGKILLed without deregistering).
WORKER_HEARTBEAT_TTL=60s

# Visibility timeout: how long a job may sit in "running" with a stale
# claimed_at before the reaper considers the claiming worker dead and
# reclaims it.
JOB_VISIBILITY_TIMEOUT=1m
# How often the reaper scans for stale claims.
REAPER_INTERVAL=30s

# Logging.
LOG_LEVEL=info
