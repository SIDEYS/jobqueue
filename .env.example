# Postgres connection used by the API, worker, and scheduler binaries.
DATABASE_URL=postgres://jobqueue:jobqueue@localhost:5432/jobqueue?sslmode=disable

# HTTP address the API binds to.
API_ADDR=:8080

# Worker pool.
WORKER_CONCURRENCY=4
WORKER_CLAIM_BATCH_SIZE=4
WORKER_POLL_INTERVAL=500ms
WORKER_MAX_POLL_INTERVAL=5s
WORKER_JOB_TIMEOUT=30s
WORKER_DRAIN_TIMEOUT=25s

# Visibility timeout: how long a job may sit in "running" with a stale
# claimed_at before the reaper considers the claiming worker dead and
# reclaims it.
JOB_VISIBILITY_TIMEOUT=1m

# Logging.
LOG_LEVEL=info
